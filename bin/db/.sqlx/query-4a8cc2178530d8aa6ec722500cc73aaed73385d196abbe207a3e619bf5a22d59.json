  "db_name": "PostgreSQL",
  "query": "SELECT s.id, m.name, m.type AS \"typ: MissionType\", s.start, d.amount\n        FROM gear_bank_deposits d\n        INNER JOIN missions_schedule s ON s.id = d.id\n        INNER JOIN missions m ON m.id = s.mission\n        WHERE d.member = $1\n        ORDER BY s.start DESC",
