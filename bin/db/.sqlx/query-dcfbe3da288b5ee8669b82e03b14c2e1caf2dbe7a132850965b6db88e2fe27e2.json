  "query": "UPDATE bank_requests\n        SET status = $4,\n            resolved = CASE WHEN $4::VARCHAR IN ('paid', 'declined') THEN NOW() ELSE NULL END\n        WHERE id = $1 AND payer = $2 AND status = $3\n        RETURNING id, requester, payer, amount, reason, status, created, resolved",
