  "db_name": "PostgreSQL",
  "query": "\n                    SELECT\n                        a.id,\n                        s.name,\n                        s.cost,\n                        s.class,\n                        s.base,\n                        s.plate_template,\n                        s.fuel_capacity,\n                        s.transport_cost,\n                        s.animations\n                    FROM\n                        garage_addons a\n                    INNER JOIN\n                        garage_shop s\n                    ON\n                        s.id = a.id\n                    WHERE\n                        s.base = (SELECT v.id FROM garage_vehicles v WHERE v.plate = $1)\n                        AND a.count > 0",
